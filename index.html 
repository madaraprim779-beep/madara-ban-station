<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MADARA BAN TOOL 🛡️</title>
    <style>
        :root { --neon-red: #ff0000; --bg-dark: #0a0a0a; --card-bg: #151515; }
        body { background: var(--bg-dark); color: white; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; overflow-x: hidden; }
        
        .ban-card { background: var(--card-bg); border: 1px solid #333; border-top: 4px solid var(--neon-red); width: 90%; max-width: 450px; padding: 30px; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); text-align: center; position: relative; }
        
        h1 { font-size: 1.8rem; margin-bottom: 5px; letter-spacing: 2px; text-transform: uppercase; color: var(--neon-red); }
        .subtitle { color: #888; font-size: 0.9rem; margin-bottom: 25px; }

        .input-group { text-align: left; margin-bottom: 20px; }
        label { display: block; font-size: 0.8rem; color: #aaa; margin-bottom: 8px; text-transform: uppercase; font-weight: bold; }
        
        input, select { width: 100%; padding: 12px; background: #202020; border: 1px solid #444; color: white; border-radius: 6px; box-sizing: border-box; outline: none; transition: 0.3s; }
        input:focus { border-color: var(--neon-red); box-shadow: 0 0 10px rgba(255,0,0,0.2); }

        .btn-ban { width: 100%; padding: 15px; background: var(--neon-red); color: white; border: none; border-radius: 6px; font-weight: bold; font-size: 1rem; cursor: pointer; text-transform: uppercase; transition: 0.3s; margin-top: 10px; }
        .btn-ban:hover { background: #cc0000; transform: translateY(-2px); box-shadow: 0 5px 15px rgba(255,0,0,0.4); }

        /* Effet de scan */
        #scan-box { display: none; margin-top: 20px; padding: 15px; border: 1px dashed var(--neon-red); background: rgba(255,0,0,0.05); border-radius: 6px; }
        .loader { height: 4px; width: 100%; background: #222; position: relative; overflow: hidden; margin-top: 10px; }
        .loader::after { content: ''; width: 40%; height: 100%; background: var(--neon-red); position: absolute; left: -40%; animation: loading 1.5s infinite linear; }
        @keyframes loading { to { left: 100%; } }
